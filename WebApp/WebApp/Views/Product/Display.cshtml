@model WebApp.Models.Product

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">📋 Product Details</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-4">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Name"
                             class="img-fluid rounded shadow-sm mb-3 w-100"
                             style="object-fit: cover; max-height: 300px;" />
                    }
                    else
                    {
                        <div class="bg-light rounded d-flex align-items-center
                                    justify-content-center mb-3"
                             style="height: 300px;">
                            <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                        </div>
                    }
                    @if (Model.ImageUrls != null && Model.ImageUrls.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var imageUrl in Model.ImageUrls)
                            {
                                <img src="@imageUrl" alt="Product Image"
                                     class="img-thumbnail"
                                     style="width: 80px; height: 80px; object-fit: cover; cursor: pointer;"
                                     onclick="document.getElementById('mainImg').src='@imageUrl'" />
                            }
                        </div>
                    }
                </div>
                <div class="col-md-8">
                    <table class="table table-borderless mb-0">
                        <tr>
                            <th class="w-25 text-muted">Name</th>
                            <td class="fw-semibold fs-5">@Model.Name</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Price</th>
                            <td class="text-success fw-bold fs-5">@Model.Price.ToString("C")</td>
                        </tr>
                        <tr>
                            <th class="text-muted">Description</th>
                            <td class="text-muted">@Model.Description</td>
                        </tr>
                    </table>
                </div>

            </div>
        </div>

        <div class="card-footer d-flex gap-2">
            <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-outline-warning">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                <i class="bi bi-trash me-1"></i> Delete
            </a>
        </div>
    </div>
</div>