@model IEnumerable<WebBanHang.Models.Product>
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="row mt-3 mb-4">
    <div class="col-lg-2 d-none d-lg-block">
        <div class="list-group shadow-sm fw-bold" style="font-size: 13px; border-radius: 10px;">
            <a href="#" class="list-group-item list-group-item-action border-0 py-3"><i class="fa-solid fa-mobile-screen text-secondary"></i> Điện thoại, Tablet</a>
            <a href="#" class="list-group-item list-group-item-action border-0 py-3"><i class="fa-solid fa-laptop text-secondary"></i> Laptop, PC</a>
            <a href="#" class="list-group-item list-group-item-action border-0 py-3"><i class="fa-solid fa-headphones text-secondary"></i> Âm thanh, Mic</a>
            <a href="#" class="list-group-item list-group-item-action border-0 py-3"><i class="fa-solid fa-stopwatch text-secondary"></i> Đồng hồ, Camera</a>
            <a href="#" class="list-group-item list-group-item-action border-0 py-3"><i class="fa-solid fa-tv text-secondary"></i> Tivi, Điện máy</a>
        </div>
    </div>

    <div class="col-lg-7 col-md-12">
        <div id="mainBanner" class="carousel slide shadow-sm rounded overflow-hidden" data-bs-ride="carousel">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="https://images.unsplash.com/photo-1610945265064-0e34e5519bbf?w=800&h=350&fit=crop" class="d-block w-100" alt="Banner 1">
                </div>
                <div class="carousel-item">
                    <img src="https://images.unsplash.com/photo-1517336714731-489689fd1ca8?w=800&h=350&fit=crop" class="d-block w-100" alt="Banner 2">
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#mainBanner" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#mainBanner" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>
        <div class="row mt-3 g-2">
            <div class="col-6"><img src="https://images.unsplash.com/photo-1525547719571-a2d4ac8945e2?w=400&h=150&fit=crop" class="img-fluid rounded shadow-sm w-100"></div>
            <div class="col-6"><img src="https://images.unsplash.com/photo-1585060544812-6b45742d762f?w=400&h=150&fit=crop" class="img-fluid rounded shadow-sm w-100"></div>
        </div>
    </div>

    <div class="col-lg-3 d-none d-lg-block">
        <div class="d-flex flex-column gap-3">
            <img src="https://images.unsplash.com/photo-1546868871-7041f2a55e12?w=300&h=160&fit=crop" class="img-fluid rounded shadow-sm w-100">
            <img src="https://images.unsplash.com/photo-1505156868547-9b49f4df4e04?w=300&h=160&fit=crop" class="img-fluid rounded shadow-sm w-100">
            <img src="https://images.unsplash.com/photo-1585399000684-d2f72660f092?w=300&h=160&fit=crop" class="img-fluid rounded shadow-sm w-100">
        </div>
    </div>
</div>

<h3 class="fw-bold mb-3 mt-5 text-uppercase" style="color: #d70018;">Sản phẩm nổi bật</h3>
<div class="row row-cols-2 row-cols-md-4 row-cols-lg-5 g-3">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm border-0" style="border-radius: 10px;">
                <div class="text-center pt-3">
                    <img src="@item.ImageUrl" class="card-img-top" style="height: 150px; object-fit: contain;">
                </div>
                <div class="card-body d-flex flex-column">
                    <h6 class="card-title fw-bold" style="font-size: 13px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@item.Name</h6>
                    <p class="card-text fw-bold mb-3" style="color: #d70018; font-size: 15px;">@item.Price.ToString("#,##0") ₫</p>

                    <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@item.Id" class="btn text-white w-100 mt-auto fw-bold" style="background-color: #d70018; border-radius: 5px; font-size: 13px;">
                        MUA NGAY
                    </a>
                </div>
            </div>
        </div>
    }
</div>