@model WebBanHang.Models.Category

@{
    ViewData["Title"] = "Xóa danh mục";
}

<h2>Xóa danh mục</h2>

<div class="alert alert-warning">
    Bạn có chắc muốn xóa danh mục <strong>@Model.Name</strong> không?
</div>

<form asp-area="Admin" asp-controller="Category" asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Xóa</button>
    <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
