@model IEnumerable<WebBanHang.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ hàng";
    var total = Model.Sum(i => i.Product.Price * i.Quantity);
}

<h2 class="mt-4 mb-4">🛒 Giỏ hàng của bạn</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-warning">@TempData["Message"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        Giỏ hàng đang trống.
        <a asp-controller="Product" asp-action="Index">Quay lại mua sắm ngay!</a>
    </div>
}
else
{
    <table class="table table-bordered align-middle shadow-sm">
        <thead class="table-light">
            <tr>
                <th>Hình ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Giá</th>
                <th style="width: 160px;">Số lượng</th>
                <th>Thành tiền</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <img src="@item.Product.ImageUrl" style="width: 70px; height: 70px; object-fit: contain; border-radius: 5px;" />
                    </td>
                    <td>@item.Product.Name</td>
                    <td class="text-brand fw-bold">@item.Product.Price.ToString("#,##0") VNĐ</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <a asp-action="DecreaseQuantity" asp-route-id="@item.Product.Id" class="btn btn-sm btn-outline-secondary">-</a>
                            <span class="fw-bold">@item.Quantity</span>
                            <a asp-action="IncreaseQuantity" asp-route-id="@item.Product.Id" class="btn btn-sm btn-outline-secondary">+</a>
                        </div>
                    </td>
                    <td class="text-brand fw-bold">@((item.Product.Price * item.Quantity).ToString("#,##0")) VNĐ</td>
                    <td>
                        <a asp-action="RemoveFromCart" asp-route-id="@item.Product.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="card shadow-sm">
        <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <h4 class="text-brand fw-bold mb-0">Tổng tiền: @total.ToString("#,##0") VNĐ</h4>
            <div class="d-flex gap-2">
                <a asp-controller="Product" asp-action="Index" class="btn btn-secondary">Tiếp tục mua sắm</a>
                <a asp-action="ClearCart" class="btn btn-outline-danger">Xóa giỏ hàng</a>
                <a asp-action="Checkout" class="btn btn-success">Thanh toán</a>
            </div>
        </div>
    </div>
}
