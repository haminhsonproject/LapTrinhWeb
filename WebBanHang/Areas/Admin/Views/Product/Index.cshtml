@model IEnumerable<WebBanHang.Models.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Quản lý sản phẩm</h2>
    <div>
        <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="btn btn-outline-secondary me-2">Danh mục</a>
        <a asp-area="" asp-controller="Product" asp-action="Add" class="btn btn-danger">Thêm sản phẩm</a>
    </div>
</div>

<table class="table table-bordered table-hover bg-white shadow-sm">
    <thead class="table-light">
        <tr>
            <th>Hình ảnh</th>
            <th>Tên sản phẩm</th>
            <th>Danh mục</th>
            <th>Giá</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><img src="@item.ImageUrl" style="width: 70px; height: 70px; object-fit: contain;" /></td>
                <td>@item.Name</td>
                <td>@item.Category?.Name</td>
                <td class="text-danger fw-bold">@item.Price.ToString("#,##0") VNĐ</td>
                <td>
                    <a asp-area="" asp-controller="Product" asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Sửa</a>
                    <a asp-area="" asp-controller="Product" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
