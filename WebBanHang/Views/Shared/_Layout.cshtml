@using WebBanHang.Extensions
@using WebBanHang.Models
@{
    var layoutCart = Context.Session.Get<List<CartItem>>("Cart") ?? new List<CartItem>();
    var layoutCartCount = layoutCart.Sum(item => item.Quantity);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DoCongNghe.Vn</title>

    <script>
        (function () {
            var saved = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-bs-theme', saved);
        })();
    </script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root,
        [data-bs-theme="light"] {
            --brand: #1d4ed8;
            --brand-hover: #1e40af;
            --bs-body-bg: #f4f6f8;
        }

        [data-bs-theme="dark"] {
            --brand: #3b82f6;
            --brand-hover: #60a5fa;
            --bs-body-bg: #0f172a;
            --bs-body-color: #e2e8f0;
        }

        body {
            transition: background-color .2s ease, color .2s ease;
        }

        .cps-header {
            background-color: var(--brand);
            color: white;
            transition: background-color .2s ease;
        }

            .cps-header a {
                color: white;
                text-decoration: none;
            }

                .cps-header a:hover {
                    color: #f3f4f6;
                }

        .search-input {
            border-radius: 8px 0 0 8px;
            border: none;
        }

        .search-btn {
            border-radius: 0 8px 8px 0;
            background-color: white;
            color: #333;
            border: none;
        }

        .cps-subnav {
            background-color: var(--bs-tertiary-bg, var(--bs-body-bg));
            border-bottom: 1px solid var(--bs-border-color, #e5e5e5);
        }

            .cps-subnav a {
                color: var(--bs-body-color);
                text-decoration: none;
            }

                .cps-subnav a:hover {
                    color: var(--brand);
                }

        .theme-toggle {
            background: rgba(255, 255, 255, .15);
            border: none;
            color: white;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background .2s ease;
        }

            .theme-toggle:hover {
                background: rgba(255, 255, 255, .3);
            }

        /* Brand-colored text/buttons (used in place of the old hardcoded red for branding,
           as opposed to text-danger/btn-danger which stay red for genuine errors/destructive actions) */
        .text-brand {
            color: var(--brand) !important;
        }

        .btn-brand {
            background-color: var(--brand);
            border-color: var(--brand);
            color: #fff;
        }

            .btn-brand:hover,
            .btn-brand:focus {
                background-color: var(--brand-hover);
                border-color: var(--brand-hover);
                color: #fff;
            }

        /* Keep Bootstrap's "primary" utilities in sync with the brand color */
        .btn-primary {
            background-color: var(--brand);
            border-color: var(--brand);
        }

            .btn-primary:hover,
            .btn-primary:focus,
            .btn-primary:active {
                background-color: var(--brand-hover);
                border-color: var(--brand-hover);
            }

        .btn-outline-primary {
            color: var(--brand);
            border-color: var(--brand);
        }

            .btn-outline-primary:hover,
            .btn-outline-primary:focus,
            .btn-outline-primary:active {
                background-color: var(--brand);
                border-color: var(--brand);
                color: #fff;
            }

        .text-primary {
            color: var(--brand) !important;
        }

        a {
            color: var(--brand);
        }

        .nav-pills .nav-link.active,
        .nav-pills .show > .nav-link {
            color: #fff;
            background-color: var(--brand);
            border-color: var(--brand-hover);
        }
    </style>
</head>
<body>
    <header class="cps-header py-2 shadow-sm">
        <div class="container d-flex align-items-center justify-content-between">
            <a href="/Home" class="fs-4 fw-bold">
                <i class="fa-solid fa-mobile-screen"></i> DoCongNghe.Vn
            </a>

            <div class="input-group w-40" style="max-width: 400px;">
                <input type="text" class="form-control search-input" placeholder="Bạn cần tìm gì?">
                <button class="btn search-btn"><i class="fa-solid fa-magnifying-glass"></i></button>
            </div>

            <div class="d-flex align-items-center gap-4 fw-semibold" style="font-size: 14px;">
                <button id="themeToggle" type="button" class="theme-toggle" title="Chuyển giao diện sáng/tối">
                    <i id="themeIcon" class="fa-solid fa-moon"></i>
                </button>

                <a href="#" class="text-center"><i class="fa-solid fa-phone fs-5"></i><br>Gọi mua hàng</a>
                <a href="/Cart" class="text-center"><i class="fa-solid fa-bag-shopping fs-5"></i><br>Giỏ hàng @(layoutCartCount > 0 ? $"({layoutCartCount})" : "")</a>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a href="#" class="text-center text-success">
                        <i class="fa-regular fa-circle-user fs-5"></i><br>
                        Chào @User.Identity.Name
                    </a>

                    <form asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                          method="post"
                          class="text-center m-0 p-0">
                        <button type="submit"
                                class="btn btn-link text-white text-decoration-none p-0 fw-semibold"
                                style="font-size: 14px;">
                            <i class="fa-solid fa-right-from-bracket fs-5"></i><br>
                            Đăng xuất
                        </button>
                    </form>
                }
                else
                {
                    <a asp-area="Identity"
                       asp-page="/Account/Login"
                       class="text-center">
                        <i class="fa-regular fa-circle-user fs-5"></i><br>
                        Đăng nhập
                    </a>

                    <a asp-area="Identity"
                       asp-page="/Account/Register"
                       class="text-center">
                        <i class="fa-solid fa-user-plus fs-5"></i><br>
                        Đăng ký
                    </a>
                }

                @if (User.IsInRole(SD.Role_Admin))
                {
                    <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="text-center text-warning"><i class="fa-solid fa-gear fs-5"></i><br>Quản trị</a>
                }
            </div>
        </div>
    </header>

    <nav class="cps-subnav shadow-sm mb-4">
        <div class="container d-flex gap-4 py-2 fw-bold" style="font-size: 15px;">
            <a href="#"><i class="fa-solid fa-mobile-button text-secondary"></i> Điện thoại</a>
            <a href="#"><i class="fa-solid fa-laptop text-secondary"></i> Laptop</a>
            <a href="#"><i class="fa-solid fa-headphones text-secondary"></i> Âm thanh</a>
            <a href="#"><i class="fa-solid fa-stopwatch text-secondary"></i> Đồng hồ</a>
        </div>
    </nav>

    <div class="container" style="min-height: 65vh;">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var root = document.documentElement;
            var toggleBtn = document.getElementById('themeToggle');
            var icon = document.getElementById('themeIcon');

            function syncIcon() {
                var isDark = root.getAttribute('data-bs-theme') === 'dark';
                icon.className = isDark ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
            }

            syncIcon();

            toggleBtn.addEventListener('click', function () {
                var next = root.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
                root.setAttribute('data-bs-theme', next);
                localStorage.setItem('theme', next);
                syncIcon();
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>