@using Microsoft.AspNetCore.Identity
@using WebBanHang.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <a href="#" class="text-center text-success">
        <i class="fa-regular fa-circle-user fs-5"></i><br />
        Chào @User.Identity?.Name
    </a>

    <form asp-area="Identity"
          asp-page="/Account/Logout"
          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
          method="post"
          class="text-center m-0 p-0">
        <button type="submit"
                class="btn btn-link text-decoration-none p-0">
            <i class="fa-solid fa-right-from-bracket fs-5"></i><br />
            Đăng xuất
        </button>
    </form>
}
else
{
    <a asp-area="Identity" asp-page="/Account/Login" class="text-center">
        <i class="fa-regular fa-circle-user fs-5"></i><br />
        Đăng nhập
    </a>

    <a asp-area="Identity" asp-page="/Account/Register" class="text-center">
        <i class="fa-solid fa-user-plus fs-5"></i><br />
        Đăng ký
    </a>
}